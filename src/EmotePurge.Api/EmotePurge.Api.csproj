<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>337718c5-f6e4-4f56-a61e-2598ed5a33cc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
  </ItemGroup>

  <!-- The auth filters, ApiErrorCodes and TwitchClaimTypes are internal on purpose — they are this
       assembly's contract with itself, not a public API. The filter-matrix tests assert exactly
       those constants, so they read them rather than re-typing the string literals: a renamed error
       code must break the test, not silently make it assert against a value nobody returns. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EmotePurge.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmotePurge.Infrastructure\EmotePurge.Infrastructure.csproj" />
    <ProjectReference Include="..\EmotePurge.Core\EmotePurge.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Local-only LAN override (docs/Operations.md). Stays in the build output so the
         lan launch profile finds it, but never goes into a publish output or a container
         image, where the operator's hostname would be baked in. -->
    <Content Update="appsettings.Lan.json" CopyToPublishDirectory="Never" Condition="Exists('appsettings.Lan.json')" />
  </ItemGroup>
</Project>
