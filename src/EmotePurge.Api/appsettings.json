{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=emotepurge;Username=emotepurge;Password=change-me"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=change-me"
  },
  "Channels": {
    "MaxActiveChannels": 80
  },
  "Tags": {
    "RunsEnabled": false
  },
  "SevenTv": {
    "SearchBudget": {
      "MaxRequestsPerWindow": 50,
      "WindowSeconds": 60,
      "ChannelIdentityMaxRequestsPerWindow": 40,
      "LowWatermark": 10,
      "DefaultLockoutSeconds": 3600,
      "ResolutionBackoffBaseSeconds": 60,
      "ResolutionBackoffMaxSeconds": 3600
    }
  },
  "RateLimiting": {
    "InteractiveRead": {
      "TokenLimit": 300,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriodSeconds": 1
    },
    "Voting": {
      "TokenLimit": 120,
      "TokensPerPeriod": 2,
      "ReplenishmentPeriodSeconds": 1
    },
    "Bookkeeping": {
      "PermitLimit": 120
    },
    "ChannelResync": {
      "PermitLimit": 5
    },
    "PublicHealth": {
      "PermitLimit": 30
    },
    "PublicLegal": {
      "PermitLimit": 60
    }
  },
  "Auth": {
    "AdminTwitchLogins": [ "sensitron" ],
    "ModCheckCacheTtlMinutes": 10,
    "Twitch": {
      "RedirectUri": "http://localhost:5151/api/auth/twitch/callback",
      "PostLoginRedirectUrl": "/"
    }
  },
  "Legal": {
    "ContentPath": null
  }
}
