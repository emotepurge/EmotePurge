{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "TwitchLib.Client.TwitchClient": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=emotepurge;Username=emotepurge;Password=change-me"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=change-me"
  },
  "SevenTv": {
    "EventApi": {
      "Enabled": false
    },
    "ResyncIntervalSeconds": 60,
    "SearchBudget": {
      "MaxRequestsPerWindow": 50,
      "WindowSeconds": 60,
      "ChannelIdentityMaxRequestsPerWindow": 40,
      "LowWatermark": 10,
      "DefaultLockoutSeconds": 3600,
      "ResolutionBackoffBaseSeconds": 60,
      "ResolutionBackoffMaxSeconds": 3600
    }
  },
  "Retention": {
    "Enforce": false,
    "IntervalHours": 24,
    "StartupDelayMinutes": 10,
    "MaxAccountsPerRun": 100
  }
}
