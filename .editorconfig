root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# .NET analyzer severity levels.
#
# These diagnostics are info-level: a normal `dotnet build` doesn't print them, but the
# Sonar scanner reads them from the build and imports them as findings. The first full scan
# therefore consisted two-thirds of them (95 of 142). Filtering happens here instead of at import,
# because Sonar only knows fully on or fully off — and fully off would also have swallowed the few
# Roslyn findings that are actually worth something (an unpropagated CancellationToken was among them).
#
# What's set to `none` here was deliberately deselected, not just annoying. Everything without an
# entry stays active and therefore keeps showing up in the scan, even when it's newly added.
[*.cs]

# 72 findings. Hits the project's logging style systematically, not individual slip-ups;
# addressing the finding one by one would mean rebuilding the logging pattern everywhere.
dotnet_diagnostic.CA1873.severity = none

# Micro-optimizations with no relation to an observed problem.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1822.severity = none

# Style recommendations from the ASP.NET Core and regex analyzers, respectively.
dotnet_diagnostic.ASP0015.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none

# CA1861 ("prefer static readonly fields over constant arrays") is a micro-optimization with the
# same reasoning as CA1859/CA1822 above — but only inside test assertions, where a literal array
# passed straight into Assert.Equal(...)/(...).Should().BeEquivalentTo(...) is the point, not a
# hot path. Scoped to tests/** only, so the rule stays active for src/**.
[tests/**/*.cs]
dotnet_diagnostic.CA1861.severity = none
