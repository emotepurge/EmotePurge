POSTGRES_USER=emotepurge
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch logins with access to the admin area (/admin/*), comma-separated, no whitespace requirement.
# Enter your own login here — otherwise the admin area returns a blank 403.
ADMIN_TWITCH_LOGINS=
# 32-byte key (base64) for encrypting the Twitch tokens in Postgres.
# Generate e.g. with: openssl rand -base64 32
AUTH_TWITCH_TOKEN_ENCRYPTION_KEY=
# 7TV EventAPI live updates (WebSocket) in the Worker; false = periodic REST resync only.
SEVENTV_EVENTAPI_ENABLED=false
# Interval of the periodic full 7TV sync; can be stretched to e.g. 300 once the WebSocket is active.
SEVENTV_RESYNC_INTERVAL_SECONDS=60
# Interval of the Helix live poll in the Worker (GET /helix/streams, App Access Token) for the
# daily live coverage (A10). A poll that sees a channel live credits that day with exactly this
# interval length in live minutes.
TWITCH_LIVE_POLL_INTERVAL_SECONDS=300
# Channel-specific bots that appear on no third-party list (comma-separated Twitch user IDs, not
# logins). Only supplements the built-in static list of known bots (nightbot, streamelements,
# fossabot, moobot, streamlabs, sery_bot) — does not replace it; empty is the normal case.
TWITCH_ADDITIONAL_BOT_ACCOUNT_IDS=
# Data retention job (#243/#244, DataRetentionWorker): false (the default) only counts and logs a
# warning every tick; flip to true only after watching a dry run's log line.
RETENTION_ENFORCE=false
# Byte ceiling per harness run (#69), in megabytes. This puts load on a third-party log service:
# 30 days of a large channel is around 490 MB, a small channel stays well below that. Try a small
# channel first; a run aborted at the limit yields a resume point and metrics, but no replay
# fidelity for the full window.
HARNESS_MAX_MEGABYTES_PER_RUN=200
# UTC day (ISO yyyy-MM-dd) after the prod deploy of #73 (D+1), from which shared-chat messages no
# longer count toward own usage. Without this value, a binding harness run aborts with exit 3
# before touching the database or log archive (fail-closed, D4) — empty means: only `--diagnostic`
# runs, a run without a gate verdict. After a rollback of the worker image during the measurement
# window, reset this to the day after the redeploy.
HARNESS_SHARED_CHAT_CUTOVER=
# Create once before the very first harness run (locally and on the VPS) — without this step
# Docker creates the missing bind-mount target as root:root, but the image runs as appuser with a
# fixed uid/gid of 999 (see src/EmotePurge.Worker/Dockerfile), and the first run fails with
# "Permission denied" (#69 Task 8a):
#   mkdir -p harness-reports && sudo chown 999:999 harness-reports
# Always run locally with --build afterward: the service has its own `build:` without `image:`,
# and `docker compose run` without `--build` happily keeps running an existing, potentially
# ancient image (Rule 15).
#   docker compose --profile harness run --build --rm harness <channel>
# Without a cutover date set above, diagnostic-only, without a gate verdict:
#   docker compose --profile harness run --build --rm harness <channel> --diagnostic
